LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_ADMIN_USER_ID=
APP_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_MAX_OUTPUT_TOKENS=
OPENAI_TIMEOUT_MS=
OPENAI_MEMORY_LIMIT=
KNOWLEDGE_MAX_CHARS=

# --- Auth (WebAuthn / Passkey) ---
# local | staging | production  (unknown => local)
AUTH_ENVIRONMENT=local
# off | observe | enforce  (unknown => enforce)
AUTH_ENFORCEMENT_MODE=off
# Local: localhost | Staging Branch Deploy host | Production: studio.egaonokiroku.co.jp
# Never use production RP ID on staging.
AUTH_RP_ID=localhost
AUTH_RP_NAME=Smile AI Studio
# Exact origins only (comma-separated). Never use wildcards.
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:8888,http://localhost:8888
# Optional extra exact origin (staging Branch Deploy URL, etc.)
AUTH_PREVIEW_ORIGIN=
AUTH_APP_URL=http://127.0.0.1:8888
AUTH_COOKIE_SECURE=0
AUTH_IP_HASH_SALT=
# Bootstrap owner (do not commit real address). Enable only when no owner exists.
AUTH_BOOTSTRAP_ENABLED=0
AUTH_BOOTSTRAP_OWNER_EMAIL=
# console | resend
AUTH_EMAIL_PROVIDER=console
AUTH_EMAIL_FROM=
RESEND_API_KEY=
# Local tests only — never enable in staging/production
AUTH_TEST_EXPOSE_EMAIL_TOKEN=0
# Admin production publish remains disabled unless explicitly enabled / allowlisted
AUTH_ADMIN_PUBLISH_ENABLED=0
# Staging only: allow LINE test push to configured admin (default off)
AUTH_STAGING_LINE_TEST_ENABLED=0
